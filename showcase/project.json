     "x": 8,
     "y": 11
    }
   ]
  },
  {
   "name": "inventaire",
   "trigger": "auto",
   "switch": 20,
   "commands": [
    {
     "c": "switch",
     "n": 20,
     "on": false
    },
    {
     "c": "sfx",
     "sound": "curseur"
    },
    {
     "c": "list_select",
     "widget": "menu_objets",
     "var": 22,
     "cancel": true
    },
    {
     "c": "if_var",
     "n": 22,
     "op": "==",
     "value": 0,
