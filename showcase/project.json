         "c": "var",
         "n": 44,
         "op": "=",
         "from": "var",
         "value": 10
        },
        {
         "c": "var",
         "n": 44,
         "op": "-",
         "from": "var",
         "value": 11
        },
        {
         "c": "if_var",
         "n": 44,
         "op": ">=",
         "value": 32768,
         "then": [],
         "else": [
          {
           "c": "var",
           "n": 10,
           "op": "=",
           "from": "var",
           "value": 11
          }
         ]
        },
        {
         "c": "sfx",
         "sound": "curseur"
        },
        {
         "c": "msg",
         "text": "Glou glou... PV \\v[10]/\\v[11]. (Potions : \\v[17])"
        }
       ]
      }
     ],
     "else": []
    },
    {
     "c": "if_var",
     "n": 22,
     "op": "==",
     "value": 1,
     "then": [
      {
       "c": "msg",
       "text": "Niv \\v[14]  PV \\v[10]/\\v[11]  ATK \\v[12]  DEF \\v[13] XP \\v[15]/\\v[16]  Or \\v[18]  Potions \\v[17]"
      }
     ],
     "else": []
    }
   ]
  },
