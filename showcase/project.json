  {
   "name": "gagner_niveau",
   "trigger": "none",
   "commands": [
    {
     "c": "loop",
     "do": [
      {
       "c": "rem",
       "text": "v43 = XP - seuil ; wrap >= 32768 = pas assez"
      },
      {
       "c": "var",
       "n": 43,
       "op": "=",
       "from": "var",
       "value": 15
      },
      {
       "c": "var",
       "n": 43,
       "op": "-",
       "from": "var",
       "value": 16
      },
      {
       "c": "if_var",
       "n": 43,
       "op": ">=",
       "value": 32768,
       "then": [
        {
         "c": "break"
        }
       ],
       "else": []
      },
      {
       "c": "var",
       "n": 15,
       "op": "=",
       "from": "var",
       "value": 43
      },
      {
       "c": "var",
       "n": 14,
       "op": "+",
       "value": 1
      },
      {
       "c": "var",
       "n": 11,
       "op": "+",
       "value": 6
      },
      {
       "c": "var",
       "n": 12,
       "op": "+",
       "value": 2
      },
      {
       "c": "var",
       "n": 13,
       "op": "+",
       "value": 1
      },
      {
       "c": "var",
       "n": 10,
       "op": "=",
       "from": "var",
       "value": 11
      },
      {
       "c": "var",
       "n": 16,
       "op": "+",
       "value": 15
      },
      {
       "c": "sfx",
       "sound": "curseur"
      },
      {
       "c": "flash",
       "r": 31,
       "g": 31,
       "b": 12,
       "frames": 16
      },
      {
       "c": "msg",
       "text": "Niveau \\v[14] ! PV max \\v[11], ATK \\v[12], DEF \\v[13]."
      }
     ]
    }
   ]
  },
  {
   "name": "game_over",
