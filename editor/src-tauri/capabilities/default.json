{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Accès fichiers du projet ouvert via le dialogue",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "cargo",
          "cmd": "cargo",
          "args": true
        }
      ]
    }
  ]
}