# .gitignore snes
*.sfc
*.smc
*.ps
*.obj
*.sym
*.pic
*.pal
*.map
node_modules/
target/
# build : les .asm/.ps de engine/src sont les INTERMEDIAIRES des .c
# (PVSnesLib compile .c -> .ps -> .asm -> .obj). Les versionner les
# transforme en sources aux yeux du wildcard de snes_rules.
engine/src/*.asm
engine/src/*.ps
engine/src/data/*.asm
engine/src/data/*.ps
# ... sauf les vraies sources assembleur, écrites ou générées comme telles
!engine/src/data/databanks.asm
linkfile
soundbank.asm
soundbank.bnk
soundbank.h
*.bnk
editor/public/project
