# .gitignore snes
*.sfc
*.smc
*.ps
*.obj
*.sym
*.pic
*.pal
*.map
node_modules/
target/
# build : les .asm/.ps de engine/src sont les INTERMEDIAIRES des .c
# (PVSnesLib compile .c -> .ps -> .asm -> .obj). Les versionner les
# transforme en sources aux yeux du wildcard de snes_rules.
engine/src/*.asm
engine/src/*.ps
engine/src/data/*.asm
engine/src/data/*.ps
# ... sauf les .asm ECRITS A LA MAIN, qui n'ont pas de .c du meme nom
!engine/src/actorsfast.asm
!engine/src/vbudgetfast.asm
!engine/src/vramfast.asm
linkfile
soundbank.asm
soundbank.bnk
soundbank.h
*.bnk
editor/public/project

# regression pixel : le core libretro n' est pas versionne (2,4 Mo)
tools/regress/snes9x_libretro.*
tools/regress/harness
tools/regress/out/

# captures du smoke test de l'editeur (tools/gate-editor.sh)
editor/tools/smoke-out/
tools/savestate/out/
